# Copy to .env and fill in real values: cp .env.example .env
# These are read only by the serverless functions in api/ — no VITE_ prefix,
# so Vite never inlines them into the browser bundle. On Vercel, add them as
# Secret env vars (vercel env add <NAME> production --type secret).

# Vision (Gemini). Get keys at https://aistudio.google.com/apikey — ideally from
# two separate projects so each has its own daily free-tier quota.
GEMINI_API_KEY=
GEMINI_FALLBACK_API_KEY=

# Explanation (OpenRouter, routes to openai/gpt-4o). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
